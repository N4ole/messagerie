{
  "name": "Messagerie",
  "dockerComposeFile": "compose.yaml",
  "service": "dev",
  "workspaceFolder": "/workspaces/messagerie",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "containerEnv": {
    "DATABASE_URL": "postgres://postgres:postgres@db:5432/postgres"
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "forwardPorts": [8080, 5173],
  "customizations": {
    "vscode": {
      "extensions": ["rust-lang.rust-analyzer", "tauri-apps.tauri-vscode", "dbaeumer.vscode-eslint", "esbenp.prettier-vscode"]
    }
  }
}
