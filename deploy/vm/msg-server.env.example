# /etc/messagerie/msg-server.env — configuration NON secrète (0644).
# Les secrets sont dans /etc/messagerie/credentials/ (0600, root).
MSG_SITE_NAME=paris.example.org
MSG_WEBAUTHN_RP_ID=paris.example.org
MSG_WEBAUTHN_ORIGIN=https://paris.example.org
MSG_LOG_JSON=1
MSG_DB_MAX_CONNECTIONS=15
# MSG_FEDERATION_PEERS=/etc/messagerie/peers.json
# MSG_FEDERATION_PROXY=socks5h://127.0.0.1:9050
# MSG_WEB_DIR=/usr/local/share/messagerie/web
# Par instance (/etc/messagerie/instance-N.env) :
#   MSG_BIND=127.0.0.1:808N
#   MSG_METRICS_BIND=127.0.0.1:910N
