# Unité systemd du serveur de messagerie (une par instance : msg-server@1,
# msg-server@2… derrière HAProxy ou nginx). Secrets transmis par
# LoadCredential (jamais dans l'environnement ni sur la ligne de commande).
[Unit]
Description=Messagerie chiffrée — instance %i
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/local/bin/msg-server serve
EnvironmentFile=/etc/messagerie/msg-server.env
EnvironmentFile=-/etc/messagerie/instance-%i.env
LoadCredential=server_secret:/etc/messagerie/credentials/server_secret
LoadCredential=database_url:/etc/messagerie/credentials/database_url
LoadCredential=metrics_token:/etc/messagerie/credentials/metrics_token
Environment=MSG_SERVER_SECRET_FILE=%d/server_secret
Environment=DATABASE_URL_FILE=%d/database_url
Environment=MSG_METRICS_TOKEN_FILE=%d/metrics_token
Restart=on-failure
RestartSec=2s

# Durcissement : utilisateur dynamique, système en lecture seule, aucun
# privilège, appels système restreints.
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
