[Unit]
Description=Messagerie — sauvegarde chiffrée de la base
After=postgresql.service

[Service]
Type=oneshot
User=postgres
Environment=PGDATABASE=messagerie BACKUP_DIR=/var/backups/messagerie BACKUP_RECIPIENTS=/etc/messagerie/backup-recipients.txt BACKUP_KEEP=28
ExecStart=/usr/local/lib/messagerie/backup.sh
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/backups/messagerie
ProtectHome=yes
PrivateTmp=yes
